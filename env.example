# =============== 通用(两种 compose 模式都共用本 .env) ===============
# 主控 Web 登录密码
MASTER_PASSWORD=scan
# 会话签名密钥，生产环境请修改
SECRET_KEY=afrog-master-secret-change-me

# =============== 数据库连接(分布式部署必看) ===============
# 只需要把 MONGO_HOST / REDIS_HOST 改成远程机器 IP 即可连接异地数据库，
# 端口、账号、密码、认证库、库编号均可单独配置。
# 若设了完整的 MONGO_URI / REDIS_URL，则优先使用完整连接串、忽略下面的拆分项。
#
# --- MongoDB ---
# 远程部署时改成: 10.0.0.5 (或你的 mongo 机器 IP)
MONGO_HOST=localhost
MONGO_PORT=27017
# beholder mongo root 账号(即 MONGO_INITDB_ROOT_USERNAME/PASSWORD)
MONGO_USER=scan
MONGO_PASSWORD=scan
# 认证库(root 账号一般为 admin)
MONGO_AUTH_SOURCE=admin
# afrog 独立使用的 mongo 数据库名(不碰 beholder 数据)
MONGO_DB=afrog
# 完整连接串(可选，设置后忽略上面 MONGO_HOST/PORT/USER/PASSWORD/AUTH_SOURCE)
# MONGO_URI=mongodb://scan:pass@10.0.0.5:27017/?authSource=admin

# --- Redis ---
# 远程部署时改成: 10.0.0.6 (或你的 redis 机器 IP)
REDIS_HOST=localhost
REDIS_PORT=6379
# beholder redis requirepass
REDIS_PASSWORD=scan
# afrog 使用的 redis 库编号(避免与 beholder 的 db0 冲突，默认 2)
REDIS_DB=2
# 完整连接串(可选，设置后忽略上面 REDIS_HOST/PORT/PASSWORD/DB)
# REDIS_URL=redis://:pass@10.0.0.6:6379/2

# =============== worker 节点 ===============
# 留空则每个容器自动生成唯一 id(hostname-uuid)，单机 --scale worker=N 或多机部署均无需改
# 如需在监控页显示可读名字，可填如 worker-beijing-1，此时每个节点须各自不同
WORKER_ID=
# afrog 版本(留空取最新 release)，docker-compose.merged.yml 自动下载用
AFROG_VERSION=latest
# 单个目标扫描超时(秒)
SCAN_TIMEOUT=1200
# 每个 worker 容器内并发扫描 afrog 任务数
WORKER_CONCURRENCY=2

# ---- 仅 docker-compose.merged.yml 使用 ----
# beholder 数据目录，绝对路径(含 redis/data、mongodb/db 等子目录)
# BEHOLDER_DATA=D:/your/beholder/project/data

# =============== API 调用(v1) ===============
# 供 AI/程序化调用 /api/v1/* 使用的密钥，逗号分隔可配多个。
# 必填！留空则该组接口返回 503。
# 生成方法: python -c "import secrets; print(secrets.token_hex(32))"
API_KEYS=
